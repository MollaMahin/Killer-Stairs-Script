-- Main Tab with Lucide Home Icon
local MainTab = Window:CreateTab("Main", "home")

MainTab:CreateSection("Teleportation")

MainTab:CreateButton({
   Name = "Teleport to the Top",
   Callback = function()
       local player = game.Players.LocalPlayer
       local character = player.Character or player.CharacterAdded:Wait()
       
       local killerTP = workspace:FindFirstChild("killerTP")
       if killerTP then
           character:MoveTo(killerTP.Position + Vector3.new(0, 3, 0))
           
           Rayfield:Notify({
               Title = "Notification",
               Content = "Teleported!",
               Duration = 3,
               Image = "chevrons-right", -- Lucide Double Arrow
           })
       end
   end,
})

MainTab:CreateButton({
   Name = "Teleport to the Finish Line",
   Callback = function()
       local player = game.Players.LocalPlayer
       local character = player.Character or player.CharacterAdded:Wait()
       
       if character then
           character:MoveTo(Vector3.new(-2, 601, -1224))
           
           Rayfield:Notify({
               Title = "Notification",
               Content = "Teleported!",
               Duration = 3,
               Image = "chevrons-right", -- Lucide Double Arrow
           })
       end
   end,
})

MainTab:CreateSection("Speed Hack")

MainTab:CreateSlider({
   Name = "WalkSpeed",
   Range = {16, 100},
   Increment = 1,
   Suffix = "Speed",
   CurrentValue = 16,
   Flag = "SpeedSlider",
   Callback = function(Value)
       local player = game.Players.LocalPlayer
       local character = player.Character or player.CharacterAdded:Wait()
       local humanoid = character:FindFirstChildOfClass("Humanoid")
       
       if humanoid then
           humanoid.WalkSpeed = Value
       end
   end,
})

MainTab:CreateSection("Credits")
MainTab:CreateLabel("Script Made by MMP (@MMP_Main)")

MainTab:CreateButton({
   Name = "Copy discord link (For support and keys)",
   Callback = function()
       if setclipboard then
           setclipboard("https://discord.gg/2MPZG3MEVP")
           Rayfield:Notify({
               Title = "Notification",
               Content = 'Copied "https://discord.gg/2MPZG3MEVP"!',
               Duration = 3,
               Image = "chevrons-right", -- Lucide Double Arrow
           })
       else
           Rayfield:Notify({
               Title = "Error",
               Content = "Your executor does not support setclipboard.",
               Duration = 3,
               Image = "chevrons-right", -- Lucide Double Arrow
           })
       end
   end,
})

-- Player Tab with Lucide User Icon
local PlayerTab = Window:CreateTab("Player", "user")

PlayerTab:CreateSection("Actions")

PlayerTab:CreateButton({
   Name = "Reset Player",
   Callback = function()
       local player = game.Players.LocalPlayer
       local character = player.Character or player.CharacterAdded:Wait()
       
       if character then
           character:BreakJoints()
       end
   end,
})

PlayerTab:CreateSection("Emotes")

PlayerTab:CreateButton({
   Name = "E Dance",
   Callback = function()
       local TextChatService = game:GetService("TextChatService")
       local ReplicatedStorage = game:GetService("ReplicatedStorage")
       
       if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
           local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
           if generalChannel then
               generalChannel:SendAsync("/e dance")
           end
       else
           local chatEvent = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
           if chatEvent and chatEvent:FindFirstChild("SayMessageRequest") then
               chatEvent.SayMessageRequest:FireServer("/e dance", "All")
           end
       end
   end,
})

